# ==========================================
# CONFIGURACIÓN DE BASE DE DATOS MYSQL
# ==========================================
# Host y Puerto
DB_HOST=proyecto_bases_mysql_db
DB_PORT=3506

# Variables de inicialización de MySQL (usadas por docker-compose.yml y utils/db.py)
MYSQL_DATABASE=controlescolar_db
MYSQL_USER=myuser
MYSQL_PASSWORD=mypassword

# Variables de conexión (usadas por docker-entrypoint.sh y seed_data.py)
DB_NAME=controlescolar_db
DB_USER=myuser
DB_PASSWORD=mypassword

# ==========================================
# CONFIGURACIÓN DE FLASK
# ==========================================
SECRET_KEY=a-super-secret-key
FLASK_ENV=development
FLASK_DEBUG=1
